# ============================================================================
# OmniRoute + OpenClaw Configuration
# ============================================================================
# 
# This file contains all configuration options for the system.
# Copy this file to .env and customize as needed.
# 
# IMPORTANT: Never commit .env file to git (contains secrets)
# ============================================================================

# --- Security Secrets (Generated automatically by update.sh) ---
# These will be auto-generated with secure random values on first run
STORAGE_ENCRYPTION_KEY=
JWT_SECRET=
API_KEY_SECRET=
OPENCLAW_PASSWORD=
INITIAL_PASSWORD=

# --- Project Paths ---
# These paths are relative to the project root
PROJECT_ROOT=/home/creator/PROJECTS/free-ai-aggregator
OPENCLAW_DATA_DIR=./data/openclaw
OMNIROUTE_DATA_DIR=./data/omniroute

# --- Service Ports ---
PORT=20128              # OmniRoute Dashboard and API
OPENCLAW_PORT=18789     # OpenClaw Gateway

# --- Monitoring Ports (Optional - only used with monitoring stack) ---
PROMETHEUS_PORT=9090    # Prometheus metrics
GRAFANA_PORT=3000       # Grafana dashboards

# --- Grafana Configuration (Optional) ---
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# --- OmniRoute Configuration ---
# OMNIROUTE_API_KEY=your_optional_key_here

# --- OpenClaw Configuration ---
# If you want to use a specific OmniRoute API key in OpenClaw:
# OMNIROUTE_API_KEY=sk-omniroute-any-key

# --- Monitoring & Metrics ---
ENABLE_METRICS=true     # Enable Prometheus metrics endpoint

# --- Advanced Performance Tuning ---
# OMNIROUTE_DISABLE_TOKEN_HEALTHCHECK=false
# OMNIROUTE_HIDE_HEALTHCHECK_LOGS=false
# OMNIROUTE_MAX_CONCURRENT_REQUESTS=100
# OMNIROUTE_REQUEST_TIMEOUT=120000

# --- Redis Configuration ---
# REDIS_URL=redis://redis:6379

# --- Node.js Configuration ---
# NODE_ENV=production

# ============================================================================
# SECURITY NOTES:
# ============================================================================
# 
# 1. All secrets are auto-generated on first run with secure random values
# 2. Default passwords are NO LONGER "admin" - they are randomly generated
# 3. Save the generated passwords shown at end of installation
# 4. Use ./rotate-secrets.sh to rotate all secrets anytime
# 5. Never commit .env file to version control
# 
# ============================================================================
