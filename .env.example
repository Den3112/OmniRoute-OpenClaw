# --- Security Secrets (Generated automatically by update.sh) ---
STORAGE_ENCRYPTION_KEY=
JWT_SECRET=
API_KEY_SECRET=
OPENCLAW_PASSWORD=admin

# --- Service Ports ---
PORT=20128              # OmniRoute Dashboard and API
OPENCLAW_PORT=18789     # OpenClaw Gateway

# --- OmniRoute Configuration ---
INITIAL_PASSWORD=admin
# OMNIROUTE_API_KEY=your_optional_key_here

# --- OpenClaw Configuration ---
# If you want to use a specific OmniRoute API key in OpenClaw:
# OMNIROUTE_API_KEY=sk-omniroute-any-key

# --- Advanced ---
# NODE_ENV=production
# PORT=20128
# REDIS_URL=redis://redis:6379

# --- Performance Optimization ---
# OMNIROUTE_DISABLE_TOKEN_HEALTHCHECK=false
# OMNIROUTE_HIDE_HEALTHCHECK_LOGS=false
# OMNIROUTE_MAX_CONCURRENT_REQUESTS=100
# OMNIROUTE_REQUEST_TIMEOUT=120000
