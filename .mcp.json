    "Memory": {
      "type": "stdio",
      "command": "wsl",
      "args": [
        "-d",
        "Ubuntu-22.04",
        "npx",
        "-y",
        "@modelcontextprotocol/server-memory"
      ]
    },
    "Context7": {
      "type": "stdio",
